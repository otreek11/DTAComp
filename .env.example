# Copie para .env (não versionado) e ajuste os valores.

# --- Banco (container postgres) ---
POSTGRES_DB=dtacomp
POSTGRES_USER=dtacomp
POSTGRES_PASSWORD=dtacomp

# --- Armazenamento S3 local (container rustfs, equivalente ao Cloudflare R2) ---
S3_BUCKET=dtacomp
S3_ACCESS_KEY=dtacomp
S3_SECRET_KEY=dtacomp-s3-secret

# --- API ---
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
# "prod" reproduz produção; "prod,dev" também cria admin@dta.dev e revisor@dta.dev (senha dev12345)
SPRING_PROFILES_ACTIVE=prod,dev
CORS_ORIGINS=http://localhost:8081

# --- Front ---
FRONT_PORT=8081
